    "/api/auth/register/patron": {
      "post": {
        "tags": [
          "Auth"
        ],
        "description": "Register a new patron account",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "full_name": {
                  "type": "string",
                  "example": "Test Patron"
                },
                "email": {
                  "type": "string",
                  "example": "testpatron@gmail.com"
                },
                "phone_number": {
                  "type": "string",
                  "example": "81234567"
                },
                "password": {
                  "type": "string",
                  "example": "Testpatron123!"
                },
                "confirm_password": {
                  "type": "string",
                  "example": "Testpatron123!"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/auth/register/vendor": {
      "post": {
        "tags": [
          "Auth"
        ],
        "description": "Register a new vendor account and linked stall",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "full_name": {
                  "type": "string",
                  "example": "Swagger Test Vendor"
                },
                "email": {
                  "type": "string",
                  "example": "swaggervendor123@gmail.com"
                },
                "phone_number": {
                  "type": "string",
                  "example": "91234567"
                },
                "password": {
                  "type": "string",
                  "example": "Testvendor123!"
                },
                "confirm_password": {
                  "type": "string",
                  "example": "Testvendor123!"
                },
                "stall_name": {
                  "type": "string",
                  "example": "Swagger Chicken Rice"
                },
                "cuisine_type": {
                  "type": "string",
                  "example": "Chinese"
                },
                "description": {
                  "type": "string",
                  "example": "Test stall created from Swagger"
                },
                "unit_number": {
                  "type": "string",
                  "example": "#01-99"
                },
                "hawker_centre_id": {
                  "type": "number",
                  "example": 1
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Vendor account and stall created successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Email is already registered"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
